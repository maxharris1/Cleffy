{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(node *)",
            "Bash(git *)",
            "Bash(gh *)",
            "Bash(docker *)",
            "Bash(supabase *)",
            "Bash(deno *)",
            "Bash(ls *)",
            "Bash(cat *)",
            "Bash(rg *)",
            "Bash(grep *)",
            "Bash(find *)",
            "Bash(head *)",
            "Bash(tail *)",
            "Bash(wc *)",
            "Bash(sed *)",
            "Bash(awk *)",
            "Bash(jq *)",
            "Bash(mkdir *)",
            "Bash(cp *)",
            "Bash(mv *)",
            "Bash(touch *)",
            "Bash(curl http://localhost*)",
            "Bash(curl http://127.0.0.1*)",
            "Bash(sleep *)",
            "Bash(bash scripts/*)",
            "Bash(./scripts/*)",
            "Read",
            "Edit",
            "Write",
            "WebFetch",
            "WebSearch"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git push * --force*)",
            "Bash(git push * -f*)",
            "Bash(git push *+*)",
            "Bash(git push * main*)",
            "Bash(git push * dev)",
            "Bash(git push * dev:*)",
            "Bash(git push * HEAD:main*)",
            "Bash(git push * HEAD:dev*)",
            "Bash(gh pr merge*)",
            "Bash(gh api *merge*)",
            "Bash(gh repo delete*)",
            "Bash(supabase link*)",
            "Bash(supabase db push*)",
            "Bash(supabase * --linked*)",
            "Bash(supabase * --project-ref*)",
            "Bash(supabase secrets*)",
            "Bash(supabase functions deploy*)",
            "Bash(supabase branches*)",
            "Bash(supabase projects*)",
            "Read(./.env)",
            "Read(./.env.production.local)"
        ]
    }
}
