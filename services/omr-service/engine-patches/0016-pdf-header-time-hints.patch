+    private static final class Component
+    {
+        private final boolean[][] mask;
+
+        private final Rectangle2D bounds;
+
+        private Component (boolean[][] mask,
+                           int minX,
+                           int minY,
+                           int maxX,
+                           int maxY)
+        {
+            this.mask = mask;
+            this.bounds = new Rectangle2D.Double(minX, minY, (maxX - minX) + 1, (maxY - minY) + 1);
+        }
+
+        private boolean isInk (int x,
+                                int y)
+        {
+            if ((y < 0) || (x < 0) || (y >= mask.length) || (x >= mask[0].length)) {
+                return false;
+            }
+            return mask[y][x];
+        }
+
+        private boolean touches (Component other)
+        {
+            final int x0 = (int) Math.max(bounds.getX(), other.bounds.getX());
+            final int y0 = (int) Math.max(bounds.getY(), other.bounds.getY());
+            final int x1 = (int) Math.min(bounds.getMaxX(), other.bounds.getMaxX());
+            final int y1 = (int) Math.min(bounds.getMaxY(), other.bounds.getMaxY());
+            for (int y = y0; y < y1; y++) {
+                for (int x = x0; x < x1; x++) {
+                    if (isInk(x, y) && other.isInk(x, y)) {
+                        return true;
+                    }
+                }
+            }
+            return false;
+        }
+
+        private static Component union (Component a,
+                                          Component b)
+        {
+            final int height = Math.max(a.mask.length, b.mask.length);
+            final int width = Math.max(a.mask[0].length, b.mask[0].length);
+            final boolean[][] mask = new boolean[height][width];
+            int minX = Integer.MAX_VALUE;
+            int minY = Integer.MAX_VALUE;
+            int maxX = 0;
+            int maxY = 0;
+            for (int y = 0; y < height; y++) {
+                for (int x = 0; x < width; x++) {
+                    if (a.isInk(x, y) || b.isInk(x, y)) {
+                        mask[y][x] = true;
+                        minX = Math.min(minX, x);
+                        minY = Math.min(minY, y);
+                        maxX = Math.max(maxX, x);
+                        maxY = Math.max(maxY, y);
+                    }
+                }
+            }
+            return new Component(mask, minX, minY, maxX, maxY);
+        }
+    }
