+/**
+ * Recover an opening numerical time column from the book's PDF page and keep
+ * that proven column out of header key extraction.
+ * <p>
+ * Identity is the embedded music-font encoding name plus a nonempty outline.
+ * First scope is one numerator digit over one denominator digit in an ordinary
+ * staff header. Ink uses the loader DPI scale and the same 0.90/0.85 staff-free
+ * minima as named quarter rests. No piece name, filename, hash, subset prefix,
+ * character code, coordinate, glyph-ID or pitch selector.
+ */
+public final class PdfHeaderTimeHints
+{
+    private static final Logger logger = LoggerFactory.getLogger(PdfHeaderTimeHints.class);
+
+    private static final ConcurrentHashMap<String, List<Hint>> CACHE = new ConcurrentHashMap<>();
+
+    private PdfHeaderTimeHints ()
+    {
+    }
+
+    /** One named, visibly painted numeral on a page. */
+    public static final class Hint
+    {
+        public final int digit;
+
+        public final String glyphName;
+
+        public final String fontName;
+
+        public final Path2D pdfPath;
+
+        public final Rectangle2D pageBox;
+
+        Hint (int digit,
+              String glyphName,
+              String fontName,
+              Path2D pdfPath,
+              Rectangle2D pageBox)
+        {
+            this.digit = digit;
+            this.glyphName = glyphName;
+            this.fontName = fontName;
+            this.pdfPath = pdfPath;
+            this.pageBox = pageBox;
+        }
+    }
+
+    /**
+     * Encoding digit names, including an optional {@code time.} prefix.
+     * Character codes are not consulted.
+     */
+    public static Integer digitOf (String glyphName)
+    {
+        if (glyphName == null) {
+            return null;
+        }
+        String name = glyphName;
+        if (name.startsWith("time.")) {
+            name = name.substring(5);
+        }
+        return switch (name) {
+        case "zero" -> 0;
+        case "one" -> 1;
+        case "two" -> 2;
+        case "three" -> 3;
+        case "four" -> 4;
+        case "five" -> 5;
+        case "six" -> 6;
+        case "seven" -> 7;
+        case "eight" -> 8;
+        case "nine" -> 9;
+        default -> null;
+        };
+    }
+
+    /** Single-digit numerator over 2, 4 or 8. Not a literal 3/4 rule. */
+    public static boolean ordinaryTime (int numerator,
+                                         int denominator)
+    {
+        if ((numerator < 1) || (numerator > 9)) {
+            return false;
+        }
+        return (denominator == 2) || (denominator == 4) || (denominator == 8);
+    }
+
+    public static List<Hint> scan (Path pdf,
+                                    int pageIndex)
+    {
+        if ((pdf == null) || (pageIndex < 0) || !Files.isRegularFile(pdf)) {
+            return List.of();
+        }
+        final String name = pdf.getFileName().toString().toLowerCase();
+        if (!name.endsWith(".pdf")) {
+            return List.of();
+        }
+        final String key;
+        try {
+            key = pdf.toAbsolutePath().normalize() + "|hdrtime|" + Files.size(pdf) + "|" + pageIndex;
+        } catch (IOException ex) {
+            return List.of();
+        }
+        return CACHE.computeIfAbsent(key, ignored -> readPage(pdf, pageIndex));
+    }
+
+    public static List<Hint> scanUncached (Path pdf,
+                                         int pageIndex)
+    {
+        return readPage(pdf, pageIndex);
+    }
+
+    /**
+     * Width to pass to {@code KeyColumn.retrieveKeys} so the projection ends at
+     * the left of the proven time-pair union. Returns {@code maxHeaderWidth}
+     * when evidence is missing, inconsistent, or fails ink proof.
+     */
+    public static int keySearchWidth (SystemInfo system,
+                                        int maxHeaderWidth)
+    {
+        if ((system == null) || (maxHeaderWidth <= 0)) {
+            return maxHeaderWidth;
+        }
+        final Sheet sheet = system.getSheet();
+        final Integer dpi = PdfQuarterRestHints.effectivePdfDpi();
+        final Path input;
+        try {
+            input = sheet.getStub().getBook().getInputPath();
+        } catch (RuntimeException ex) {
+            return maxHeaderWidth;
+        }
+        if ((dpi == null) || (input == null) || !Files.isRegularFile(input)
+                || !input.getFileName().toString().toLowerCase().endsWith(".pdf")) {
+            return maxHeaderWidth;
+        }
+        if ((sheet.getSkew() != null) && (Math.abs(sheet.getSkew().getSlope()) > 0.02)) {
+            logger.info("PDF header time skipped: unsupported sheet skew {}",
+                    sheet.getSkew().getSlope());
+            return maxHeaderWidth;
+        }
+        if ((sheet.getWidth() <= 0) || (sheet.getHeight() <= 0)) {
+            return maxHeaderWidth;
+        }
+        final int pageIndex = sheet.getStub().getNumber() - 1;
+        final List<Hint> hints = scan(input, pageIndex);
+        if (hints.isEmpty()) {
+            logger.info(
+                    "PDF header time: page {} dpi {} canvas {}x{} digits=0 excluded=0",
+                    pageIndex,
+                    dpi,
+                    sheet.getWidth(),
+                    sheet.getHeight());
+            return maxHeaderWidth;
+        }
+
+        final ByteProcessor noStaff = sheet.getPicture().getSource(Picture.SourceKey.NO_STAFF);
+        final ByteProcessor binary = sheet.getPicture().getSource(Picture.SourceKey.BINARY);
+        if ((noStaff == null) || (binary == null)) {
+            return maxHeaderWidth;
+        }
+
+        final List<Staff> staves = system.getStaves();
+        final List<PdfQuarterRestHints.StaffAnchor> anchors = new ArrayList<>();
+        int staffed = 0;
+        for (int i = 0; i < staves.size(); i++) {
+            final Staff staff = staves.get(i);
+            if (staff.isTablature() || staff.isOneLineStaff() || (staff.getLineCount() != 5)) {
+                continue;
+            }
+            staffed++;
+            final int x = staff.getHeaderStart();
+            anchors.add(new PdfQuarterRestHints.StaffAnchor(
+                    i,
+                    staff.getFirstLine().yAt(x),
+                    staff.getLastLine().yAt(x),
+                    staff.getSpecificInterline()));
+        }
+        if (staffed == 0) {
+            return maxHeaderWidth;
+        }
+
+        int excluded = 0;
+        final List<Placed> placed = new ArrayList<>();
+        for (Hint hint : hints) {
+            final Path2D sheetPath = PdfQuarterRestHints.toLoaderSheetPath(
+                    hint,
+                    dpi,
+                    sheet.getWidth(),
+                    sheet.getHeight());
+            if (sheetPath == null) {
+                logger.info(
+                        "PDF header time skipped: loader canvas mismatch dpi={} sheet={}x{} page={}",
+                        dpi,
+                        sheet.getWidth(),
+                        sheet.getHeight(),
+                        hint.pageBox);
+                return maxHeaderWidth;
+            }
+            final Rectangle2D outline = sheetPath.getBounds2D();
+            final Integer staffIndex = PdfQuarterRestHints.uniqueStaff(outline, anchors);
+            if (staffIndex == null) {
+                excluded++;
+                continue;
+            }
+            final Staff staff = staves.get(staffIndex);
+            final Integer clefStop = staff.getClefStop();
+            if (clefStop == null) {
+                excluded++;
+                continue;
+            }
+            if (outline.getMaxX() <= clefStop) {
+                excluded++;
+                continue;
+            }
+            if (outline.getMinX() >= (staff.getHeaderStart() + maxHeaderWidth)) {
+                excluded++;
+                continue;
+            }
+            placed.add(new Placed(hint, sheetPath, outline, staff, staffIndex));
+        }
+
+        logger.info(
+                "PDF header time: page {} dpi {} canvas {}x{} digits={} excluded={} outlines={}",
+                pageIndex,
+                dpi,
+                sheet.getWidth(),
+                sheet.getHeight(),
+                hints.size(),
+                excluded,
+                placed.size());
+
+        final List<Pair> pairs = new ArrayList<>();
+        for (int i = 0; i < staves.size(); i++) {
+            final Staff staff = staves.get(i);
+            if (staff.isTablature() || staff.isOneLineStaff() || (staff.getLineCount() != 5)) {
+                continue;
+            }
+            final Pair pair = pairOnStaff(placed, staff, i, noStaff, binary);
+            if (pair == null) {
+                logger.info("PDF header time: staff#{} has no proven numeral pair", staff.getId());
+                return maxHeaderWidth;
+            }
+            pairs.add(pair);
+        }
+        if (pairs.size() != staffed) {
+            return maxHeaderWidth;
+        }
+        if (!columnsAligned(pairs)) {
+            logger.info("PDF header time: staff columns are not aligned; retaining key bounds");
+            return maxHeaderWidth;
+        }
+
+        int bound = maxHeaderWidth;
+        for (Pair pair : pairs) {
+            final int width = (int) Math.floor(pair.left) - pair.staff.getHeaderStart();
+            if (width <= 0) {
+                logger.info("PDF header time: staff#{} bound {} is inconsistent",
+                        pair.staff.getId(),
+                        width);
+                return maxHeaderWidth;
+            }
+            bound = Math.min(bound, width);
+        }
+        if (bound >= maxHeaderWidth) {
+            return maxHeaderWidth;
+        }
+        for (Pair pair : pairs) {
+            logger.info(
+                    "PDF header time pair staff#{} {}/{} left={} ink num={}/{} den={}/{} pair={}/{} font={}",
+                    pair.staff.getId(),
+                    pair.num.hint.digit,
+                    pair.den.hint.digit,
+                    Math.round(pair.left),
+                    pair.numAgreement.both,
+                    pair.numAgreement.outlineCount,
+                    pair.denAgreement.both,
+                    pair.denAgreement.outlineCount,
+                    pair.pairAgreement.both,
+                    pair.pairAgreement.outlineCount,
+                    pair.num.hint.fontName);
+        }
+        logger.info("PDF header time bounding keys at width {} (was {}) for sys#{}",
+                bound,
+                maxHeaderWidth,
+                system.getId());
+        return bound;
+    }
+
+    private static boolean columnsAligned (List<Pair> pairs)
+    {
+        if (pairs.size() < 2) {
+            return true;
+        }
+        double minLeft = Double.POSITIVE_INFINITY;
+        double maxLeft = Double.NEGATIVE_INFINITY;
+        double interline = pairs.get(0).staff.getSpecificInterline();
+        for (Pair pair : pairs) {
+            minLeft = Math.min(minLeft, pair.left);
+            maxLeft = Math.max(maxLeft, pair.left);
+            interline = Math.max(interline, pair.staff.getSpecificInterline());
+        }
+        return (maxLeft - minLeft) <= (1.2 * interline);
+    }
+
+    private static Pair pairOnStaff (List<Placed> placed,
+                                        Staff staff,
+                                        int staffIndex,
+                                        ByteProcessor noStaff,
+                                        ByteProcessor binary)
+    {
+        final List<Placed> onStaff = new ArrayList<>();
+        for (Placed placedDigit : placed) {
+            if (placedDigit.staffIndex == staffIndex) {
+                onStaff.add(placedDigit);
+            }
+        }
+        final double interline = staff.getSpecificInterline();
+        Pair found = null;
+        for (int i = 0; i < onStaff.size(); i++) {
+            for (int j = 0; j < onStaff.size(); j++) {
+                if (i == j) {
+                    continue;
+                }
+                final Placed upper = onStaff.get(i);
+                final Placed lower = onStaff.get(j);
+                if (upper.outline.getCenterY() >= lower.outline.getCenterY()) {
+                    continue;
+                }
+                if (!ordinaryTime(upper.hint.digit, lower.hint.digit)) {
+                    continue;
+                }
+                final double dx = Math.abs(upper.outline.getCenterX() - lower.outline.getCenterX());
+                final double dy = lower.outline.getCenterY() - upper.outline.getCenterY();
+                if (dx > (1.2 * interline)) {
+                    continue;
+                }
+                if ((dy < (0.4 * interline)) || (dy > (2.5 * interline))) {
+                    continue;
+                }
+                final PdfQuarterRestHints.Agreement numAg = measureDigit(
+                        upper, noStaff, binary);
+                final PdfQuarterRestHints.Agreement denAg = measureDigit(
+                        lower, noStaff, binary);
+                if ((numAg == null) || (denAg == null) || !numAg.agrees() || !denAg.agrees()) {
+                    logger.info(
+                            "PDF header time staff#{} pair {}/{} failed numeral ink num={}/{}/{} den={}/{}/{}",
+                            staff.getId(),
+                            upper.hint.digit,
+                            lower.hint.digit,
+                            (numAg == null) ? 0 : numAg.both,
+                            (numAg == null) ? 0 : numAg.outlineCount,
+                            (numAg == null) ? 0 : numAg.glyphCount,
+                            (denAg == null) ? 0 : denAg.both,
+                            (denAg == null) ? 0 : denAg.outlineCount,
+                            (denAg == null) ? 0 : denAg.glyphCount);
+                    continue;
+                }
+                final Component numComp = extractComponent(upper.sheetPath, noStaff);
+                final Component denComp = extractComponent(lower.sheetPath, noStaff);
+                if ((numComp == null) || (denComp == null) || numComp.touches(denComp)) {
+                    logger.info("PDF header time staff#{} pair {}/{} has ambiguous components",
+                            staff.getId(),
+                            upper.hint.digit,
+                            lower.hint.digit);
+                    continue;
+                }
+                final Area union = new Area(upper.sheetPath);
+                union.add(new Area(lower.sheetPath));
+                final Path2D pairPath = new Path2D.Double(union);
+                final Component pairComp = Component.union(numComp, denComp);
+                final PdfQuarterRestHints.Agreement pairAg = PdfQuarterRestHints.measure(
+                        pairPath,
+                        pairComp::isInk,
+                        staffLine(binary, noStaff),
+                        pairComp.bounds);
+                if (!pairAg.agrees()) {
+                    logger.info(
+                            "PDF header time staff#{} pair {}/{} failed pair ink both={} outline={} glyph={} skip={}",
+                            staff.getId(),
+                            upper.hint.digit,
+                            lower.hint.digit,
+                            pairAg.both,
+                            pairAg.outlineCount,
+                            pairAg.glyphCount,
+                            pairAg.staffLineSkipped);
+                    return null;
+                }
+                if (found != null) {
+                    logger.info("PDF header time staff#{} has multiple numeral pairs",
+                            staff.getId());
+                    return null;
+                }
+                found = new Pair(
+                        staff,
+                        upper,
+                        lower,
+                        numAg,
+                        denAg,
+                        pairAg,
+                        Math.min(upper.outline.getMinX(), lower.outline.getMinX()));
+            }
+        }
+        return found;
+    }
+
+    private static PdfQuarterRestHints.Agreement measureDigit (Placed placed,
+                                                                  ByteProcessor noStaff,
+                                                                  ByteProcessor binary)
+    {
+        final Component component = extractComponent(placed.sheetPath, noStaff);
+        if (component == null) {
+            return null;
+        }
+        return PdfQuarterRestHints.measure(
+                placed.sheetPath,
+                component::isInk,
+                staffLine(binary, noStaff),
+                component.bounds);
+    }
+
+    private static PdfQuarterRestHints.PixelSource staffLine (ByteProcessor binary,
+                                                                  ByteProcessor noStaff)
+    {
+        return (x, y) -> {
+            if ((x < 0) || (y < 0) || (x >= binary.getWidth()) || (y >= binary.getHeight())) {
+                return false;
+            }
+            final boolean bin = binary.get(x, y) < 128;
+            final boolean ns = (x < noStaff.getWidth()) && (y < noStaff.getHeight())
+                    && (noStaff.get(x, y) < 128);
+            return bin && !ns;
+        };
+    }
+
+    /**
+     * Untrimmed staff-free component overlapping the outline. Multiple
+     * overlapping components or an empty seed set fail rather than clip.
+     */
+    private static Component extractComponent (Path2D outline,
+                                                ByteProcessor noStaff)
+    {
+        final Rectangle2D box = outline.getBounds2D();
+        if ((box.getWidth() < 3) || (box.getHeight() < 3)) {
+            return null;
+        }
+        final int width = noStaff.getWidth();
+        final int height = noStaff.getHeight();
+        final int x0 = Math.max(0, (int) Math.floor(box.getX()));
+        final int y0 = Math.max(0, (int) Math.floor(box.getY()));
+        final int x1 = Math.min(width, (int) Math.ceil(box.getMaxX()));
+        final int y1 = Math.min(height, (int) Math.ceil(box.getMaxY()));
+        final List<int[]> seeds = new ArrayList<>();
+        for (int y = y0; y < y1; y++) {
+            for (int x = x0; x < x1; x++) {
+                if (outline.contains(x + 0.5, y + 0.5) && (noStaff.get(x, y) < 128)) {
+                    seeds.add(new int[] {x, y});
+                }
+            }
+        }
+        if (seeds.isEmpty()) {
+            return null;
+        }
+        final boolean[][] seen = new boolean[height][width];
+        final ArrayDeque<int[]> queue = new ArrayDeque<>();
+        final int[] first = seeds.get(0);
+        queue.add(first);
+        seen[first[1]][first[0]] = true;
+        int minX = first[0];
+        int minY = first[1];
+        int maxX = first[0];
+        int maxY = first[1];
+        int count = 0;
+        while (!queue.isEmpty()) {
+            final int[] p = queue.removeFirst();
+            count++;
+            if (count > 20_000) {
+                return null;
+            }
+            minX = Math.min(minX, p[0]);
+            minY = Math.min(minY, p[1]);
+            maxX = Math.max(maxX, p[0]);
+            maxY = Math.max(maxY, p[1]);
+            trySeed(p[0] - 1, p[1], noStaff, seen, queue);
+            trySeed(p[0] + 1, p[1], noStaff, seen, queue);
+            trySeed(p[0], p[1] - 1, noStaff, seen, queue);
+            trySeed(p[0], p[1] + 1, noStaff, seen, queue);
+        }
+        for (int[] seed : seeds) {
+            if (!seen[seed[1]][seed[0]]) {
+                return null;
+            }
+        }
+        return new Component(seen, minX, minY, maxX, maxY);
+    }
+
+    private static void trySeed (int x,
+                                  int y,
+                                  ByteProcessor noStaff,
+                                  boolean[][] seen,
+                                  ArrayDeque<int[]> queue)
+    {
+        if ((x < 0) || (y < 0) || (x >= noStaff.getWidth()) || (y >= noStaff.getHeight())) {
+            return;
+        }
+        if (seen[y][x] || (noStaff.get(x, y) >= 128)) {
+            return;
+        }
+        seen[y][x] = true;
+        queue.add(new int[] {x, y});
+    }
+
+    private static List<Hint> readPage (Path pdf,
+                                        int pageIndex)
+    {
+        try (PDDocument doc = Loader.loadPDF(pdf.toFile())) {
+            if (pageIndex >= doc.getNumberOfPages()) {
+                return List.of();
+            }
+            final PDPage page = doc.getPage(pageIndex);
+            if (page.getRotation() != 0) {
+                return List.of();
+            }
+            final Collector engine = new Collector(page);
+            engine.processPage(page);
+            return Collections.unmodifiableList(engine.hints);
+        } catch (Exception ex) {
+            return List.of();
+        }
+    }
