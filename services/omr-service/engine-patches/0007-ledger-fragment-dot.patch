+    //-----------------------------//
+    // isUnrecognizedLedgerFragment //
+    //-----------------------------//
+    /**
+     * Check for a dot candidate which is actually a short horizontal ledger fragment.
+     * <p>
+     * This is deliberately restricted to source ink that (1) lies on an extrapolated ledger
+     * ordinate, (2) connects continuously through another recognized head, and (3) protrudes as
+     * a thin stroke beyond that head's opposite edge. Detached dots cannot satisfy this test.
+     * The test runs only
+     * when no concrete ledger was recognized; concrete ledgers retain the historical distance
+     * check above.
+     *
+     * @param glyph the dot candidate glyph
+     * @param staff the closest staff
+     * @return true when source ink is better explained as a ledger fragment
+     */
+    private boolean isUnrecognizedLedgerFragment (Glyph glyph,
+                                                  Staff staff)
+    {
+        if ((glyph == null) || staff.isOneLineStaff() || (staff.getLineCount() != 5)) {
+            return false;
+        }
+
+        final Rectangle box = glyph.getBounds();
+        final int il = staff.getSpecificInterline();
+
+        final Point2D center = glyph.getCenter2D();
+        final double pitch = staff.pitchPositionOf(center);
+        final int ledgerPitch = 2 * (int) Math.rint(pitch / 2);
+
+        if (Math.abs(ledgerPitch) <= (staff.getLineCount() - 1)) {
+            return false;
+        }
+
+        final double ledgerY = staff.pitchToOrdinate(center.getX(), ledgerPitch);
+        if (Math.abs(center.getY() - ledgerY) > Math.max(2, il * 0.3)) {
+            return false;
+        }
+
+        final ByteProcessor source = getSourceMask();
+        if (source == null) {
+            return false;
+        }
+
+        for (Inter inter : sig.inters(HeadInter.class)) {
+            if (inter.getStaff() != staff) {
+                continue;
+            }
+
+            final Rectangle head = inter.getBounds();
+            if (LedgerFragmentEvidence.isFragment(
+                    box,
+                    head,
+                    ledgerY,
+                    il,
+                    (x, y) -> (x >= 0) && (y >= 0)
+                            && (x < source.getWidth()) && (y < source.getHeight())
+                            && (source.get(x, y) < 128))) {
+                logger.info("Rejecting dot glyph#{} as connected ledger ink beside head#{}",
+                        glyph.getId(), inter.getId());
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    //-----------------//
+    // getSourceMask //
+    //-----------------//
+    /** Use original source ink; unavailable source evidence leaves the ordinary checks intact. */
+    private ByteProcessor getSourceMask ()
+    {
+        final var picture = system.getSheet().getPicture();
+        if (picture == null) {
+            return null;
+        }
+
+        return picture.getSource(Picture.SourceKey.BINARY);
     }
 
