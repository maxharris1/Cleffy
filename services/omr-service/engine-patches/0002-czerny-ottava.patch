+    //------------------//
+    // findDashedSpan  //
+    //------------------//
+    /**
+     * Find a long sequence of short horizontal runs above a staff. This deliberately requires
+     * several separated runs and a substantial total span, which excludes ordinary text stems,
+     * staff lines and isolated punctuation.
+     */
+    private Line2D findDashedSpan (ByteProcessor buffer,
+                                   Staff staff,
+                                   int fromX,
+                                   int toX,
+                                   int anchorY)
+    {
+        final int interline = sheet.getInterline();
+        final int minDashWidth = Math.max(1, (int) Math.rint(0.30 * interline));
+        final int maxDashWidth = Math.max(minDashWidth + 1, (int) Math.rint(0.80 * interline));
+        final int maxGap = Math.max(1, (int) Math.rint(2.0 * interline));
+        final int top = (int) Math.rint(staff.getFirstLine().yAt(fromX));
+        final int yMin = Math.max(0, Math.max(top - (6 * interline), anchorY - interline));
+        final int yMax = Math.max(0, Math.min(top - (2 * interline), anchorY + interline));
+        final int left = Math.max(0, fromX);
+        final int right = Math.min(buffer.getWidth() - 1, toX);
+        Line2D best = null;
+
+        for (int y = yMin; y <= yMax; y++) {
+            final List<int[]> runs = new ArrayList<>();
+            int start = -1;
+
+            for (int x = left; x <= right + 1; x++) {
+                final boolean dark = (x <= right) && (buffer.getPixel(x, y) < 128);
+
+                if (dark && (start < 0)) {
+                    start = x;
+                } else if (!dark && (start >= 0)) {
+                    final int width = x - start;
+                    if ((width >= minDashWidth) && (width <= maxDashWidth)) {
+                        runs.add(new int[] { start, x - 1 });
+                    }
+                    start = -1;
+                }
+            }
+
+            if (runs.size() < 4) {
+                continue;
+            }
+
+            int first = runs.get(0)[0];
+            int last = runs.get(0)[1];
+            int count = 1;
+
+            if ((first - fromX) > interline) {
+                continue;
+            }
+
+            for (int i = 1; i < runs.size(); i++) {
+                final int[] run = runs.get(i);
+                if ((run[0] - last) > maxGap) {
+                    if ((count >= 4) && ((last - first) >= (6 * interline))
+                            && ((best == null) || ((last - first) > best.getX2() - best.getX1()))) {
+                        best = new Line2D.Double(first, y, last, y);
+                    }
+                    break;
+                } else {
+                    count++;
+                }
+                last = run[1];
+            }
+
+            if ((count >= 4) && ((last - first) >= (6 * interline))
+                    && ((best == null) || ((last - first) > best.getX2() - best.getX1()))) {
+                best = new Line2D.Double(first, y, last, y);
+            }
+        }
+
+        return best;
+    }
