+    //------------------//
+    // hasEndingHook   //
+    //------------------//
+    /**
+     * Check for the short vertical ending hook in the source pixels immediately after a dash
+     * span. An interior span without this ink is rejected rather than given a fabricated hook.
+     */
+    private boolean hasEndingHook (ByteProcessor buffer,
+                                   Line2D dash)
+    {
+        final int interline = sheet.getInterline();
+        final int maxX = Math.min(
+                buffer.getWidth() - 1,
+                (int) Math.rint(dash.getX2()) + Math.max(1, (int) Math.rint(0.75 * interline)));
+        final int minHeight = Math.max(1, (int) Math.rint(0.40 * interline));
+        final int maxHookWidth = Math.max(1, (int) Math.rint(0.35 * interline));
+        final int yMin = Math.max(
+                0,
+                (int) Math.rint(dash.getY1()) - Math.max(1, (int) Math.rint(0.10 * interline)));
+        final int yMax = Math.min(
+                buffer.getHeight() - 1,
+                (int) Math.rint(dash.getY1()) + interline);
+        int hookStart = -1;
+
+        for (int x = (int) Math.rint(dash.getX2()) + 1; x <= maxX; x++) {
+            int first = -1;
+            int last = -1;
+
+            for (int y = yMin; y <= yMax + 1; y++) {
+                final boolean dark = (y <= yMax) && (buffer.getPixel(x, y) < 128);
+                if (dark && (first < 0)) {
+                    first = y;
+                } else if (!dark && (first >= 0)) {
+                    last = y - 1;
+                    break;
+                }
+            }
+
+            final boolean vertical = (first >= 0) && ((last - first + 1) >= minHeight);
+            if (vertical) {
+                if (hookStart < 0) {
+                    hookStart = x;
+                }
+            } else if (hookStart >= 0) {
+                if ((x - hookStart) <= maxHookWidth) {
+                    return true;
+                }
+                hookStart = -1;
+            }
+        }
+
+        if ((hookStart >= 0) && ((maxX + 1 - hookStart) <= maxHookWidth)) {
+            return true;
+        }
+
+        return false;
+    }
