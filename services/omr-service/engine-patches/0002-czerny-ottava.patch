+    //-------------------//
+    // createMeasured    //
+    //-------------------//
+    /**
+     * Create an octave shift using a measured printed line.
+     * <p>
+     * This is used when the value glyph is recognized separately from its dashed extension.
+     * The ordinary {@link #create(Glyph, Shape, double, Staff)} path remains unchanged and
+     * continues to provide the default-size line for classifier-created symbols.
+     *
+     * @param glyph       value glyph retained by OCR
+     * @param shape       OTTAVA, QUINDICESIMA or VENTIDUESIMA
+     * @param grade       interpretation quality
+     * @param staff       related staff
+     * @param measured    actual left-to-right line span in sheet coordinates
+     * @param withHook    whether the measured span has a printed ending hook
+     * @return the created instance, or null when geometry/staff is invalid
+     */
+    public static Inter createMeasured (Glyph glyph,
+                                        Shape shape,
+                                        double grade,
+                                        Staff staff,
+                                        Line2D measured,
+                                        boolean withHook)
+    {
+        if ((staff == null) || (measured == null) || (measured.getX2() <= measured.getX1())
+                || (measured.getY1() != measured.getY2())) {
+            return null;
+        }
+
+        final OctaveShiftInter os = new OctaveShiftInter(glyph, shape, null, grade);
+        os.line = new Line2D.Double(measured.getP1(), measured.getP2());
+
+        // setStaff derives the kind and the default hook only after bounds exist. Materialize
+        // the bounds first, then retain a hook only when the source pixels proved one exists.
+        os.computeValueDimensions(staff.getSystem().getSheet());
+        os.getBounds();
+        os.setStaff(staff);
+
+        if (!withHook) {
+            os.hookEnd = null;
+        }
+
+        os.setBounds(null);
         return os;
     }
 
