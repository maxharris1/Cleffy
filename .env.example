# Supabase project configuration (client-safe values; RLS enforces access).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Stripe (client-safe values only — the secret key is an Edge Function secret,
# never a VITE_ var). Price ids come from `stripe prices create`; see the
# "Stripe billing" section of SETUP_SUPABASE.md. Leave them blank to run
# without billing: the pricing dialog then says so instead of offering
# buttons that cannot work.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_PRO_MONTHLY=price_...
VITE_STRIPE_PRICE_PRO_ANNUAL=price_...
VITE_STRIPE_PRICE_STUDIO_ANNUAL=price_...

# Founding Teacher: a second, cheaper annual price on the Pro product. Set the
# flag to "true" to show it. Turning it off later does not affect anyone who
# already subscribed — they keep renewing at the price they bought.
VITE_STRIPE_PRICE_FOUNDING_ANNUAL=price_...
VITE_STRIPE_FOUNDING_OFFER=false
