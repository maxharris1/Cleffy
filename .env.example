# Supabase project configuration (client-safe values; RLS enforces access).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Local Supabase (Cursor Cloud Agent / `npx supabase start`) ---
# Well-known local demo keys — safe to use against a local stack only.
# Cloud agent boot writes these into `.env.local` (not `.env`) so a production
# `.env` in the same checkout is never overwritten. Vite loads `.env.local`
# automatically. See `.cursor/README.md` for seeded test accounts.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
