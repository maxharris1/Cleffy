# Supabase project configuration (client-safe values; RLS enforces access).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Stripe (client-safe values only — the secret key is an Edge Function secret,
# never a VITE_ var). Price ids come from `stripe prices create`; see the
# "Stripe billing" section of SETUP_SUPABASE.md. Leave them blank to run
# without billing: the pricing dialog then says so instead of offering
# buttons that cannot work.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Personal ($7/mo, $70/yr) — the practice tool for one player.
VITE_STRIPE_PRICE_PERSONAL_MONTHLY=price_...
VITE_STRIPE_PRICE_PERSONAL_ANNUAL=price_...

# Teacher ($19/mo, $190/yr) — Personal plus the student roster.
VITE_STRIPE_PRICE_TEACHER_MONTHLY=price_...
VITE_STRIPE_PRICE_TEACHER_ANNUAL=price_...

# Academy ($49/mo, $490/yr) — Teacher for up to five instructors.
VITE_STRIPE_PRICE_ACADEMY_MONTHLY=price_...
VITE_STRIPE_PRICE_ACADEMY_ANNUAL=price_...

# Founding Teacher: a second, cheaper annual price ($99/yr) on the Teacher
# product. Set the flag to "true" to show it. Turning it off later does not
# affect anyone who already subscribed — they keep renewing at the price they
# bought.
VITE_STRIPE_PRICE_FOUNDING_ANNUAL=price_...
VITE_STRIPE_FOUNDING_OFFER=false

# --- Local Supabase (`npm run local:up`) ---
# Well-known local demo keys — safe to use against a local stack only.
# Boot writes these into `.env.local` (not `.env`) so a production `.env` in the
# same checkout is never overwritten. Vite loads `.env.local` automatically.
# Ports are a +100 offset from the Supabase defaults so this stack can run
# alongside other local Supabase projects. See `.cursor/README.md` for accounts.
# VITE_SUPABASE_URL=http://127.0.0.1:54421
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
