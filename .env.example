# Supabase project configuration (client-safe values; RLS enforces access).
#
# These two win over everything, which is what you want locally: they point the
# app at one project regardless of hostname. The deployed build leaves them
# unset and picks by hostname instead (VITE_SUPABASE_PROD_* on cleffy.io,
# VITE_SUPABASE_DEV_* everywhere else) — see `.env.production`.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Stripe (client-safe values only — the secret key is an Edge Function secret,
# never a VITE_ var). Price ids come from `stripe prices create`; see the
# "Stripe billing" section of SETUP_SUPABASE.md. Leave them blank to run
# without billing: the pricing dialog then says so instead of offering
# buttons that cannot work.
#
# The names below are the explicit override and win everywhere, which is what
# you want locally. The deployed build instead ships both catalogues as
# VITE_STRIPE_LIVE_PRICE_* / VITE_STRIPE_TEST_PRICE_* (see `.env.production`) and
# picks by hostname: cleffy.io is live, everything else sandbox.
#
# VITE_STRIPE_PUBLISHABLE_KEY is unused: no code reads it, because checkout is a
# redirect to the URL stripe-checkout returns. Leave it blank; it is kept only
# so an old .env does not look incomplete.
VITE_STRIPE_PUBLISHABLE_KEY=

# Personal ($7/mo, $70/yr) — the practice tool for one player.
VITE_STRIPE_PRICE_PERSONAL_MONTHLY=price_...
VITE_STRIPE_PRICE_PERSONAL_ANNUAL=price_...

# Teacher ($19/mo, $190/yr) — Personal plus the student roster.
VITE_STRIPE_PRICE_TEACHER_MONTHLY=price_...
VITE_STRIPE_PRICE_TEACHER_ANNUAL=price_...

# Academy ($49/mo, $490/yr) — Teacher for up to five instructors.
VITE_STRIPE_PRICE_ACADEMY_MONTHLY=price_...
VITE_STRIPE_PRICE_ACADEMY_ANNUAL=price_...

# Founding Teacher: a second, cheaper annual price ($99/yr) on the Teacher
# product. Set the flag to "true" to show it. Turning it off later does not
# affect anyone who already subscribed — they keep renewing at the price they
# bought.
VITE_STRIPE_PRICE_FOUNDING_ANNUAL=price_...
VITE_STRIPE_FOUNDING_OFFER=false

# Cloudflare Turnstile — the "I'm human" check on sign-up, log in, password
# reset, the share-link join page and the guest "save my work" email.
#
# UNSET IS OFF, and off is what every build is today: with no site key no widget
# renders, Cloudflare's script is never fetched, no token is produced, and every
# auth call goes out exactly as it did before (src/features/auth/turnstile.ts).
#
# It is half a pair, and the two halves have to be switched on TOGETHER:
#   VITE_TURNSTILE_SITE_KEY  — this file / the client build; renders the widget.
#   TURNSTILE_SECRET_KEY     — an Edge Function SECRET, never a VITE_ var:
#                              `npx supabase secrets set TURNSTILE_SECRET_KEY=… --project-ref <ref>`
#                              It is what guest-email-start verifies a token
#                              with, and what GoTrue's [auth.captcha] block in
#                              supabase/config.toml would read. The secret alone
#                              means the server demands a token no browser can
#                              mint; the site key alone means a challenge nobody
#                              verifies.
#
# Use Cloudflare's PUBLISHED TEST KEYS locally and in CI. A real site key is
# bound to real hostnames, so a production key fails every challenge on
# localhost or a Vercel preview URL:
#   always passes: site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
#   always fails:  site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA
#   always challenges (interactive): site 3x00000000000000000000FF
VITE_TURNSTILE_SITE_KEY=

# How much mail this project may send per window, for the Edge Functions that
# send it (supabase/functions/_shared/mailBudget.ts). Both are Edge Function
# secrets, not VITE_ vars, and both are OPTIONAL — the module carries defaults
# and the names are listed here so the knob is discoverable. A reserve inside
# that budget is held back for password resets and sign-up confirmations and
# cannot be spent by anything else, which is the point of the module; these two
# only say how big the whole budget is, and the default is an assumption that
# wants checking against the Resend plan's real quota.
#   MAIL_BUDGET_PER_HOUR=100
#   MAIL_BUDGET_PER_DAY=500

# Error monitoring (optional). Unset — the default — compiles monitoring out
# entirely: the Sentry SDK is not even emitted into the bundle. Set the DSN of a
# Sentry *browser* project to turn it on; reports are scrubbed of emails, tokens,
# URL query strings and annotation contents before they leave the page (see
# src/lib/monitoring/scrub.ts). The environment (production / development /
# preview / local) is derived from the hostname at runtime, and the release tag
# from VERCEL_GIT_COMMIT_SHA on Vercel builds; VITE_SENTRY_RELEASE overrides it
# when it must match a release that source maps were uploaded under.
# The Edge Functions read a separate SENTRY_DSN *secret* (supabase secrets set),
# not this variable — see supabase/functions/_shared/errorLog.ts.
VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=

# --- Release feature flags (src/lib/features.ts) ---
# Built-but-unreleased features, all OFF unless set to exactly "1". They are
# read at BUILD time (Vite inlines VITE_* vars), so flipping one needs a rebuild
# and redeploy. With a flag off the feature has no entry point at all: no
# button or toolbar tool, no background request, no lazy chunk, and nothing on
# the landing page, pricing cards or account page that sells it. The server
# side (Edge Functions, usage metering) is untouched either way.
#
# Play-along: score analysis (OMR) via score-analyze, the transport bar, audio
# playback and its piano-sample downloads. Needs the OMR service deployed.
VITE_FEATURE_PLAYALONG=0
# Fingering: the toolbar's Fingering tool, the view-only "Fingering" pill and
# the keyboard-diagram flow (AI note reads via analyze-notes).
VITE_FEATURE_FINGERING=0
# Print handwriting: on-device conversion of handwritten digits and symbols to
# type, and the stored preference that turns it on.
VITE_FEATURE_PRINT_HANDWRITING=0
# Smart import: reading the markings already on a scanned score — the
# post-upload offer, the viewer's import button and its AI pass
# (analyze-annotations, which sends page images to Anthropic). OFF at launch;
# production also has no ANTHROPIC_API_KEY.
VITE_FEATURE_SMART_IMPORT=0

# --- Local Supabase (`npm run local:up`) ---
# Well-known local demo keys — safe to use against a local stack only.
# Boot writes these into `.env.local` (not `.env`) so a production `.env` in the
# same checkout is never overwritten. Vite loads `.env.local` automatically.
# Ports are a +100 offset from the Supabase defaults so this stack can run
# alongside other local Supabase projects. See `.cursor/README.md` for accounts.
# VITE_SUPABASE_URL=http://127.0.0.1:54421
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
