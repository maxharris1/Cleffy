# dependencies / build
# No trailing slash: a bare name also catches a stray file or symlink of that
# name, which a "dir/" pattern silently lets through.
node_modules
dist
dev-dist
coverage

# environment — never commit real keys
.env
.env.*
!.env.example
# Committed on purpose: client-safe values only — they ship in the bundle anyway.
!.env.production

# supabase CLI local state
supabase/.temp
supabase/.branches

# editor / os
.DS_Store
*.local
# Claude Code writes per-user permission grants here; *.local does not catch it.
.claude/settings.local.json

# E2E artifacts
live-*.png
verify-*.png
e2e-shots

# local secrets (service accounts, etc.)
.secrets

# OMR bench CSV output
services/omr-service/bench/results
