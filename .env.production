# Production client configuration for the Vercel build.
# Client-safe ONLY: every value here ships in the browser bundle by design.
# Server secrets live in Supabase Edge Function secrets, never in this file.
#
# cleffy.io (main) builds from this file. dev.cleffy.io (dev) overrides the two
# VITE_SUPABASE_* values in the Vercel *Preview* environment to point at the
# persistent `dev` Supabase branch (qdbnlrgylelelvwbkvnm) — a real environment
# variable beats this file under Vite. See DEPLOY.md §5.
#
# That branch is paused most of the time, so dev.cleffy.io is expected to be
# down until someone unpauses it before a release test.
VITE_SUPABASE_URL=https://jibgwgosihadbjgxdsfe.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_t_IyDZsvhicFDdCjXTmvqw_nUlsfm6M

