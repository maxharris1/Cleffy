# Production client configuration for the Vercel build.
# Client-safe ONLY: every value here ships in the browser bundle by design.
# Server secrets live in Supabase Edge Function secrets, never in this file.
#
# Both cleffy.io (main) and dev.cleffy.io (dev) build from this file and
# currently share one Supabase project. To point dev.cleffy.io at a separate
# backend, override the two VITE_SUPABASE_* values for the Vercel *Preview*
# environment — a real environment variable beats this file under Vite.
VITE_SUPABASE_URL=https://jibgwgosihadbjgxdsfe.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_t_IyDZsvhicFDdCjXTmvqw_nUlsfm6M

# Stripe price ids. BOTH catalogues ship in the bundle and the app picks by
# hostname — cleffy.io uses the LIVE set, dev.cleffy.io and localhost the TEST
# set — so the split is visible here in the repo rather than hidden in a Vercel
# setting. A price id is a pointer into a catalogue the secret key gates, so
# publishing both grants nothing; see supabase/functions/_shared/stripe.ts.
#
# The Edge Functions make the same live/sandbox decision from the request Origin
# and are the authority: they re-price whatever the client names into their own
# mode, so a stale bundle cannot check out against the wrong account.

# Live — Stripe account "Cleffy" (acct_1U35FW4eZ6RX0W0g).
VITE_STRIPE_LIVE_PRICE_PERSONAL_MONTHLY=price_1U9V7M4eZ6RX0W0glzzjnokr
VITE_STRIPE_LIVE_PRICE_PERSONAL_ANNUAL=price_1U9V7R4eZ6RX0W0gEcT8ASvn
VITE_STRIPE_LIVE_PRICE_TEACHER_MONTHLY=price_1U9V7T4eZ6RX0W0giIjCensQ
VITE_STRIPE_LIVE_PRICE_TEACHER_ANNUAL=price_1U9V7s4eZ6RX0W0gYFUvnaey
VITE_STRIPE_LIVE_PRICE_ACADEMY_MONTHLY=price_1U9V854eZ6RX0W0ghUfKx12e
VITE_STRIPE_LIVE_PRICE_ACADEMY_ANNUAL=price_1U9V884eZ6RX0W0gqt1uAuRz
VITE_STRIPE_LIVE_PRICE_FOUNDING_ANNUAL=price_1U9V814eZ6RX0W0gNPPqpB4T

# Sandbox — Stripe account "Cleffy sandbox" (acct_1U35Fc9EqxUjgZtn).
VITE_STRIPE_TEST_PRICE_PERSONAL_MONTHLY=price_1U8nin9EqxUjgZtnTC00MEwP
VITE_STRIPE_TEST_PRICE_PERSONAL_ANNUAL=price_1U8niu9EqxUjgZtn3fGKope8
VITE_STRIPE_TEST_PRICE_TEACHER_MONTHLY=price_1U8niw9EqxUjgZtnSqC3tsTx
VITE_STRIPE_TEST_PRICE_TEACHER_ANNUAL=price_1U8niy9EqxUjgZtn7TBy8cdn
